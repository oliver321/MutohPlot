[Unit]
Description=MutohPlot Weboberflaeche
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/mutohplot/current
ExecStart=%h/.local/share/mutohplot/current/.venv/bin/mutohplot web --host 0.0.0.0 --port 8040
Restart=on-failure
RestartSec=3
TimeoutStopSec=infinity

[Install]
WantedBy=default.target
